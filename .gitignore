.backups/
.DS_Store
**/.DS_Store
claude/CLAUDE.local.md
public/justify-core.js
public/justify-core.js.map

# transient / dependency dirs (added during tilt-lab work)
node_modules/
.claude/scheduled_tasks.lock
# git worktrees created for isolated feature builds
.claude/worktrees/

# justify daemon's self-signed TLS cert + PRIVATE KEY - generated per-machine on
# first run (ws-server ensureCert); never commit the key.
justify/server/certs/

# transient fixtures from claude/hooks/test-install-hook-deploy.sh
.test-fixtures-*

# Python bytecode caches - never track these
__pycache__/
*.pyc

# Derived labeling screenshots - regenerated deterministically by the harness
.shots/

# sidecoach image cache: generated assets, never source
.sidecoach-cache/

# transient probe artifacts written by verification passes, never source
__flowprobe.*
__liveflow.*
__pageprobe.*
__t.js
__t.d.ts
*.tmp.js
