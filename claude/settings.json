{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npx create-next-app@latest:*)",
      "Bash(claude mcp:*)",
      "Edit(**/*.md)",
      "Edit(**/.claude/memory/**)",
      "Edit(/Users/*/.claude/projects/**/memory/**)",
      "Edit(/Users/**/memory/**)",
      "Edit(/home/**/memory/**)",
      "Edit(**/memory/**)",
      "Edit(**/MEMORY.md)",
      "Edit(.claude/memory/**)",
      "Edit(~/.claude/projects/**/memory/**)",
      "mcp__pencil"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SESSION_CWD=\"$(pwd)\" ~/.claude/startup-check.sh",
            "timeout": 10,
            "statusMessage": "Loading memory..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/node-path-default.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"systemMessage\":\"PreCompact: flushing pending memory\",\"hookSpecificOutput\":{\"hookEventName\":\"PreCompact\",\"additionalContext\":\"PRE-COMPACT: Before this context compresses, write any pending session memory entries to .claude/memory/ per CLAUDE.md memory discipline. Do this NOW.\"}}'",
            "timeout": 5,
            "statusMessage": "Flushing memory before compact..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SESSION_CWD=\"$(pwd)\" ~/.claude/startup-check.sh",
            "timeout": 10,
            "statusMessage": "Reloading memory after compaction..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/sidecoach-craft-floor.sh",
            "timeout": 15,
            "statusMessage": "Loading craft floor..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/sidecoach-taste-gate.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/sidecoach-orchestrate-edit.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/sidecoach-qa-gate-stop.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/sidecoach-keyword.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "[ -x ~/.claude/statusline-command.sh ] && bash ~/.claude/statusline-command.sh || true"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": false,
    "semgrep@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "vercel@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "discord@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "buildwithclaude": {
      "source": {
        "source": "github",
        "repo": "davepoon/buildwithclaude"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true
  },
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "voiceEnabled": true,
  "mcpServers": {
    "voice-output": {
      "command": "node",
      "args": [
        "${HOME}/.claude/voice-output/server.js"
      ]
    },
    "justify": {
      "command": "node",
      "args": [
        "${HOME}/.claude/justify/dist/server/index.js"
      ]
    },
    "peekaboo": {
      "command": "/opt/homebrew/bin/peekaboo",
      "args": [
        "mcp",
        "serve"
      ]
    }
  },
  "agentPushNotifEnabled": true
}
