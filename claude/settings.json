{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npx create-next-app@latest:*)",
      "Bash(claude mcp:*)",
      "Write(**/*.md)",
      "Edit(**/*.md)",
      "MultiEdit(**/*.md)",
      "Write(**/.claude/memory/**)",
      "Edit(**/.claude/memory/**)",
      "MultiEdit(**/.claude/memory/**)",
      "Write(/Users/*/.claude/projects/**/memory/**)",
      "Edit(/Users/*/.claude/projects/**/memory/**)",
      "MultiEdit(/Users/*/.claude/projects/**/memory/**)",
      "Write(/Users/**/memory/**)",
      "Edit(/Users/**/memory/**)",
      "MultiEdit(/Users/**/memory/**)",
      "Write(/home/**/memory/**)",
      "Edit(/home/**/memory/**)",
      "MultiEdit(/home/**/memory/**)",
      "Write(**/memory/**)",
      "Edit(**/memory/**)",
      "MultiEdit(**/memory/**)",
      "Write(**/MEMORY.md)",
      "Edit(**/MEMORY.md)",
      "MultiEdit(**/MEMORY.md)",
      "Write(.claude/memory/**)",
      "Edit(.claude/memory/**)",
      "MultiEdit(.claude/memory/**)",
      "Write(~/.claude/projects/**/memory/**)",
      "Edit(~/.claude/projects/**/memory/**)",
      "MultiEdit(~/.claude/projects/**/memory/**)",
      "mcp__pencil"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_ClickUp__clickup_",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-clickup-writes.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/justify-source-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__voice-output__speak",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/voice-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-teams-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/codex-rescue-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-approve.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/justify-source-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__visualize__show_widget",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/visualizer-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SESSION_CWD=\"$(pwd)\" ~/.claude/startup-check.sh",
            "timeout": 10,
            "statusMessage": "Loading memory..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/node-shim-heal.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "SESSION_CWD=\"$(pwd)\" ~/.claude/hooks/consolidate-nudge.sh",
            "timeout": 5,
            "statusMessage": "Checking for consolidatable beat clusters..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-compact.sh",
            "timeout": 5,
            "statusMessage": "Keeping the beats index under load budget..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/justify-watch-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking justify watch..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"systemMessage\":\"PreCompact: flushing pending memory\",\"hookSpecificOutput\":{\"hookEventName\":\"PreCompact\",\"additionalContext\":\"PRE-COMPACT: Before this context compresses, write any pending session memory entries to .claude/memory/ per CLAUDE.md memory discipline. Do this NOW.\"}}'",
            "timeout": 5,
            "statusMessage": "Flushing memory before compact..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SESSION_CWD=\"$(pwd)\" ~/.claude/startup-check.sh",
            "timeout": 10,
            "statusMessage": "Reloading memory after compaction..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-nudge.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/codex-failure-watcher.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-compact.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/node-shim-heal.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/justify-watch-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "[ -x ~/.claude/statusline-command.sh ] && bash ~/.claude/statusline-command.sh || true"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": false,
    "semgrep@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "vercel@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "discord@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "buildwithclaude": {
      "source": {
        "source": "github",
        "repo": "davepoon/buildwithclaude"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true
  },
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "voiceEnabled": true,
  "mcpServers": {
    "voice-output": {
      "command": "node",
      "args": [
        "${HOME}/.claude/voice-output/server.js"
      ]
    },
    "justify": {
      "command": "node",
      "args": [
        "${HOME}/.claude/justify/dist/server/index.js"
      ]
    },
    "peekaboo": {
      "command": "/opt/homebrew/bin/peekaboo",
      "args": [
        "mcp",
        "serve"
      ]
    }
  },
  "agentPushNotifEnabled": true
}
