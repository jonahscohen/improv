{
  "name": "beats-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server over the beats memory corpus. Lets any MCP client (Claude Code, Codex, Gemini) query the same beats that Claude Code reads through the harness.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "beats-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
